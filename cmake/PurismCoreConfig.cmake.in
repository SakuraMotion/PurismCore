@PACKAGE_INIT@

# Purism Core CMake package config. Provides the imported target
# PurismCore::PurismCore (include dirs + linkage). Consumers:
#
#   find_package(PurismCore REQUIRED)
#   target_link_libraries(app PRIVATE PurismCore::PurismCore)

