#include <winver.h>

VS_VERSION_INFO VERSIONINFO
  FILEVERSION    @PSM_VER_MAJOR@, @PSM_VER_MINOR@, @PSM_VER_PATCH@, 0
  PRODUCTVERSION @PSM_VER_MAJOR@, @PSM_VER_MINOR@, @PSM_VER_PATCH@, 0
  FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
  FILEFLAGS      0
  FILEOS         VOS_NT_WINDOWS32
  FILETYPE       VFT_DLL
  FILESUBTYPE    VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "Sakura Motion Project\0"
      VALUE "FileDescription",  "Purism Core\0"
      VALUE "FileVersion",      "@PSM_VER_STRING@\0"
      VALUE "InternalName",     "PurismCore.dll\0"
      VALUE "LegalCopyright",   "Copyright (c) 2026 Sakura Motion Project\0"
      VALUE "OriginalFilename", "PurismCore.dll\0"
      VALUE "ProductName",      "Purism Core\0"
      VALUE "ProductVersion",   "@PSM_VER_STRING@ (compat @PSM_COMPAT_STRING@)\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 0x04B0
  END
END
